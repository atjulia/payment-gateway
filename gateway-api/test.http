@baseUrl = http://localhost:8080
@apiKey = {{createAccount.response.body.api_key}}

### POST account
# @name createAccount
POST {{baseUrl}}/accounts
Content-Type: application/json

{
    "name": "Julia",
    "email": "julia@gmail.com"
}

### GET accounts
GET {{baseUrl}}/accounts
X-API-Key: {{apiKey}}

### POST invoice
# @name createInvoice
POST {{baseUrl}}/invoice
Content-Type: application/json
X-API-Key: {{apiKey}}

{
    "amount": 100.50,
    "description": "Test invoice",
    "payment_type": "credit_card",
    "card_number": "4111111111111111",
    "cvv": "123",
    "expiry_month": 12,
    "expiry_year": 2025,
    "cardholder_name": "Julia"
}

@invoiceId = {{createInvoice.response.body.id}}
GET {{baseUrl}}/invoice/{{invoiceId}}
X-API-Key: {{apiKey}}

### POST invoice with value > 10000
POST {{baseUrl}}/invoice
Content-Type: application/json
X-API-Key: {{apiKey}}

{
    "amount": 15000,
    "description": "Test invoice > 10000",
    "payment_type": "credit_card",
    "card_number": "4111111111111111",
    "cvv": "123",
    "expiry_month": 12,
    "expiry_year": 2025,
    "cardholder_name": "Julia"
} 